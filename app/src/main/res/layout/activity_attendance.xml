<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Занятия и посещаемость"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Создать занятие"
            android:textStyle="bold"
            android:textSize="18sp" />

        <Spinner
            android:id="@+id/spinnerCreateGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/etLessonDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Дата (ДД.ММ.ГГГГ)"
            android:inputType="text"
            android:maxLines="1" />

        <EditText
            android:id="@+id/etSubject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Дисциплина или тема занятия"
            android:inputType="textCapSentences"
            android:maxLines="1" />

        <Button
            android:id="@+id/btnCreateLesson"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Создать занятие" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#BDBDBD"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Выберите занятие"
            android:textStyle="bold"
            android:textSize="18sp" />

        <Spinner
            android:id="@+id/spinnerLessons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvAttendanceHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Сначала создайте занятие и добавьте студентов."
            android:paddingTop="12dp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:id="@+id/layoutAttendanceList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnSaveAttendance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Сохранить отметки"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/back"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>
